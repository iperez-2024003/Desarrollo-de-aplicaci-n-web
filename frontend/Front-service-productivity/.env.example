# URL base del microservicio de productividad (service-productivity)
VITE_PRODUCTIVITY_API_URL=http://localhost:3002/api/v1

# Token JWT del usuario autenticado.
# El inicio de sesion es responsabilidad del modulo de autenticacion (service-auth);
# este valor solo es necesario para probar el frontend de forma aislada en desarrollo.
VITE_DEV_TOKEN=
